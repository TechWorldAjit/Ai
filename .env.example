# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.tefsn4z.mongodb.net/global_ai_directory?retryWrites=true&w=majority
DB_NAME=global_ai_directory

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Server Configuration
PORT=5001
NODE_ENV=development

# Discovery Engine & Worker Limits
MAX_CANDIDATES_PER_BATCH=15
DISCOVERY_RATE_LIMIT_MS=3000
VERIFICATION_TIMEOUT_MS=6000

